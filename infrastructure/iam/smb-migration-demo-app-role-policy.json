{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SessionsTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-1:*:table/smb-migration-demo-sessions"
    },
    {
      "Sid": "UploadsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::smb-migration-demo-uploads/*"
    },
    {
      "Sid": "AppSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:*:secret:smb-migration-demo/*"
    }
  ]
}
